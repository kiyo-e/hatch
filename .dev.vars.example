# Local development (`cp .dev.vars.example .dev.vars && npm run dev`).
# Loaded automatically by `wrangler dev` and overrides `vars` in wrangler.jsonc.
# For production, use `wrangler secret put <NAME>`.

# Local hostnames: Management API & Admin UI at http://api.localhost:8787, previews at http://<envId>.localhost:8787
API_HOSTNAME=api.localhost
PREVIEW_BASE_DOMAIN=localhost

# AWS credentials (dummy values work for testing registration, listing, and Admin UI; real credentials are required to boot MicroVMs)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# Optional: temporary STS credentials (e.g., from `aws configure export-credentials`)
# AWS_SESSION_TOKEN=

# Shared secret for Management API X-CI-Secret header
CI_WEBHOOK_SECRET=replace-with-random-secret

# Optional: Cloudflare Access JWT verification (Admin UI on *.localhost bypasses Access when unset)
# CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-preview-application-audience-tag
# CF_ACCESS_ADMIN_AUD=your-admin-application-audience-tag
