{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushAppImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchDeleteImage",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:ap-northeast-1:123456789012:repository/app-preview"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "CodeArtifacts",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::app-preview-artifacts",
        "arn:aws:s3:::app-preview-artifacts/*"
      ]
    },
    {
      "Sid": "MicrovmImages",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateMicrovmImage",
        "lambda:UpdateMicrovmImage",
        "lambda:GetMicrovmImage",
        "lambda:ListMicrovmImageVersions",
        "lambda:DeleteMicrovmImageVersion",
        "lambda:DeleteMicrovmImage"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:123456789012:microvm-image:preview-pr-*"
    },
    {
      "Sid": "ListMicrovmImagesForSweep",
      "Effect": "Allow",
      "Action": "lambda:ListMicrovmImages",
      "Resource": "*"
    },
    {
      "Sid": "PassBuildRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/app-preview-microvm-build",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    }
  ]
}
