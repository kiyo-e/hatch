{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // console.error で残しているログ（起動失敗・削除の失敗など）を Workers Logs で見られるようにする
  "observability": {
    "enabled": true
  },

  // ホスト名（API_HOSTNAME と *.PREVIEW_BASE_DOMAIN）で振り分けるため、workers.dev とプレビュー URL では動かない。
  // カスタムドメインの routes で公開する（ドメインは vars に合わせて書き換える）
  "workers_dev": false,
  "preview_urls": false,
  // "routes": [
  //   { "pattern": "api.preview.example.com/*", "zone_name": "example.com" },
  //   { "pattern": "*.preview.example.com/*", "zone_name": "example.com" }
  // ],

  "durable_objects": {
    "bindings": [
      // 1 プレビュー環境 = 1 インスタンス（envId で idFromName）
      {
        "name": "PREVIEW_DO",
        "class_name": "PreviewEnvironmentDO"
      },
      // 管理画面の一覧用の台帳（単一インスタンス）
      {
        "name": "ENV_REGISTRY",
        "class_name": "EnvRegistryDO"
      }
    ]
  },
  // 適用済みのタグは書き換えない。クラスを足すときは新しいタグを追加する
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreviewEnvironmentDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EnvRegistryDO"]
    }
  ],

  "vars": {
    // MicroVM を動かすリージョンと、MicroVM 内のアプリの待受ポート
    "AWS_REGION": "ap-northeast-1",
    "APP_TARGET_PORT": "8080",
    // プレビューは <envId>.PREVIEW_BASE_DOMAIN、CI 用の管理 API と管理画面 (/admin) は API_HOSTNAME
    "PREVIEW_BASE_DOMAIN": "preview.example.com",
    "API_HOSTNAME": "api.preview.example.com",
    // 起動中のブラウザのアクセスに、3 秒ごとに再読み込みする画面を返す
    "COLD_START_LOADING_PAGE": "true",
    // PR クローズの Webhook を取りこぼしても、この日数で環境を自動破棄する
    "ZOMBIE_TTL_DAYS": "14"
    // 任意:
    // "AWS_MICROVM_EXECUTION_ROLE_ARN": "arn:aws:iam::123456789012:role/preview-microvm",
    // "AWS_EGRESS_NETWORK_CONNECTORS": "arn:aws:lambda:ap-northeast-1:aws:network-connector:aws-network-connector:INTERNET_EGRESS"
  },

  // シークレット（`wrangler secret put <NAME>` で登録。ローカルでは .dev.vars）:
  // - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
  // - AWS_SESSION_TOKEN     （任意: 一時的な認証情報を使う場合）
  // - CI_WEBHOOK_SECRET     （管理 API の X-CI-Secret）
  // - CF_ACCESS_TEAM_DOMAIN （Cloudflare Access のチームドメイン。プレビュー・管理画面で共通）
  // - CF_ACCESS_AUD         （任意: プレビューを Access で守る場合の AUD）
  // - CF_ACCESS_ADMIN_AUD   （管理画面を使う場合の、管理画面用 Access アプリの AUD）

  "dev": {
    // wrangler dev は Origin / Referer を内部の URL に書き換える。https にしておかないと、
    // Rails などの CSRF 検証や ActionCable の Origin チェックが手元で失敗する（本番では起きない）
    "upstream_protocol": "https"
  }
}
