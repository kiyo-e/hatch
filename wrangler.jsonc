{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Enable Workers Logs for error visibility (e.g. boot or cleanup failures)
  "observability": {
    "enabled": true
  },

  // Routing relies on hostnames (API_HOSTNAME and *.PREVIEW_BASE_DOMAIN), so workers.dev and preview URLs are disabled.
  // Uncomment and update `routes` for your custom domain.
  "workers_dev": false,
  "preview_urls": false,
  // "routes": [
  //   { "pattern": "api.preview.example.com/*", "zone_name": "example.com" },
  //   { "pattern": "*.preview.example.com/*", "zone_name": "example.com" }
  // ],

  "durable_objects": {
    "bindings": [
      // 1 preview environment = 1 Durable Object instance (idFromName by envId)
      {
        "name": "PREVIEW_DO",
        "class_name": "PreviewEnvironmentDO"
      },
      // Single-instance registry for Admin UI listing
      {
        "name": "ENV_REGISTRY",
        "class_name": "EnvRegistryDO"
      }
    ]
  },
  // Never edit applied migration tags; append a new tag when adding new classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreviewEnvironmentDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["EnvRegistryDO"]
    }
  ],

  "vars": {
    // AWS region for MicroVMs and listening port inside the MicroVM
    "AWS_REGION": "ap-northeast-1",
    "APP_TARGET_PORT": "8080",
    // Previews use <envId>.PREVIEW_BASE_DOMAIN; Management API and Admin UI (/admin) use API_HOSTNAME
    "PREVIEW_BASE_DOMAIN": "preview.example.com",
    "API_HOSTNAME": "api.preview.example.com",
    // Return a 3s auto-reloading HTML page to browsers while a MicroVM is booting
    "COLD_START_LOADING_PAGE": "true",
    // Auto-destroy idle environments via DO Alarm after this many days
    "ZOMBIE_TTL_DAYS": "14"
    // Optional:
    // "AWS_MICROVM_EXECUTION_ROLE_ARN": "arn:aws:iam::123456789012:role/preview-microvm",
    // "AWS_EGRESS_NETWORK_CONNECTORS": "arn:aws:lambda:ap-northeast-1:aws:network-connector:aws-network-connector:INTERNET_EGRESS"
  },

  // Secrets (`wrangler secret put <NAME>` in production, `.dev.vars` locally):
  // - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
  // - AWS_SESSION_TOKEN     (optional: for temporary STS credentials)
  // - CI_WEBHOOK_SECRET     (shared secret for Management API X-CI-Secret)
  // - CF_ACCESS_TEAM_DOMAIN (Cloudflare Access team domain, shared by previews and Admin UI)
  // - CF_ACCESS_AUD         (optional: Access Application AUD for preview subdomains)
  // - CF_ACCESS_ADMIN_AUD   (required for Admin UI: Access Application AUD for /admin)

  "dev": {
    // Keep upstream_protocol as https so wrangler dev does not rewrite Origin/Referer to http://,
    // which would break CSRF Origin checks and ActionCable locally.
    "upstream_protocol": "https"
  }
}
